#!/bin/sh
ip addr add 10.20.1.1/24 dev eth0
ip addr add 10.20.2.1/24 dev eth1
ip addr add 10.20.12.1/30 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
sysctl -w net.ipv4.ip_forward=1
ip route replace 10.20.3.0/24 via 10.20.12.2

ip route replace 10.21.3.0/24 via 10.20.1.13
ip route replace 10.21.4.0/24 via 10.20.1.14
ip route replace 10.21.5.0/24 via 10.20.1.15
ip route replace 10.21.6.0/24 via 10.20.1.16
ip route replace 10.21.7.0/24 via 10.20.1.17
ip route replace 10.21.8.0/24 via 10.20.1.18
ip route replace 10.21.9.0/24 via 10.20.1.19
ip route replace 10.21.10.0/24 via 10.20.1.20
