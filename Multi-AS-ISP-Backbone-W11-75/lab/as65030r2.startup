#!/bin/sh
set -eu
ip link set eth0 up
ip addr replace 10.30.0.2/30 dev eth0
ip link set eth1 up
ip addr replace 10.30.0.5/30 dev eth1
ip link set eth2 up
ip addr replace 10.30.0.29/30 dev eth2
ip link set eth3 up
ip addr replace 10.30.1.5/30 dev eth3
ip link set eth4 up
ip addr replace 10.30.1.29/30 dev eth4
ip link set eth5 up
ip addr replace 172.20.0.10/30 dev eth5
sysctl -w net.ipv4.ip_forward=1 >/dev/null
ip link set lo up
ip addr replace 10.30.255.2/32 dev lo
ip route replace blackhole 10.30.0.0/16 metric 400
chmod 640 /etc/frr/frr.conf /etc/frr/daemons 2>/dev/null || true
chown frr:frr /etc/frr/frr.conf /etc/frr/daemons 2>/dev/null || true
/etc/init.d/frr start
