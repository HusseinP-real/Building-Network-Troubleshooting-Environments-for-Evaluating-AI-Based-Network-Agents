#!/bin/sh
set -eu
ip link set eth0 up
ip addr replace 10.40.0.6/30 dev eth0
ip link set eth1 up
ip addr replace 10.40.0.9/30 dev eth1
ip link set eth2 up
ip addr replace 10.40.1.9/30 dev eth2
ip link set eth3 up
ip addr replace 10.40.1.33/30 dev eth3
ip link set eth4 up
ip addr replace 172.20.0.22/30 dev eth4
sysctl -w net.ipv4.ip_forward=1 >/dev/null
ip link set lo up
ip addr replace 10.40.255.3/32 dev lo
ip route replace blackhole 10.40.0.0/16 metric 400
chmod 640 /etc/frr/frr.conf /etc/frr/daemons 2>/dev/null || true
chown frr:frr /etc/frr/frr.conf /etc/frr/daemons 2>/dev/null || true
/etc/init.d/frr start
