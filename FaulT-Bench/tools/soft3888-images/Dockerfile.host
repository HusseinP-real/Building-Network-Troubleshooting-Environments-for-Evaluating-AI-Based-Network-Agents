# Minimal Debian host for vfs-backed cloud machines. APT signature checking stays enabled.
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN --mount=type=secret,id=cloud-ca,required=false,mode=0444 \
    sed -i 's@http://deb.debian.org@https://deb.debian.org@g' /etc/apt/sources.list.d/debian.sources && \
    if [ -f /run/secrets/cloud-ca ]; then export SSL_CERT_FILE=/run/secrets/cloud-ca; \
      printf 'Acquire::https::CaInfo "/run/secrets/cloud-ca";\n' > /etc/apt/apt.conf.d/99-cloud-ca; fi && \
    apt-get update -o APT::Update::Error-Mode=any && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash python3 dnsmasq-base curl bind9-dnsutils iproute2 iptables iputils-ping \
    procps util-linux ca-certificates net-tools traceroute tcpdump gawk isc-dhcp-server isc-dhcp-client \
    haproxy && rm -f /etc/apt/apt.conf.d/99-cloud-ca && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/* /usr/share/locale/*
CMD ["bash"]
