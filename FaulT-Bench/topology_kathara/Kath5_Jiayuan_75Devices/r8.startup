# Interface Mapping:
# Serial6/3 -> eth0
# FastEthernet0/0 -> eth1

# Physical Interfaces
ip addr add 58.1.1.2/8 dev eth0
ip addr add 80.1.1.1/8 dev eth1

# Loopback Interfaces
ip addr add 18.1.1.1/24 dev lo
ip addr add 18.1.2.1/24 dev lo
ip addr add 18.1.3.1/24 dev lo
ip addr add 18.1.4.1/24 dev lo
# Fallback for intermittently absent external prefixes across the virtual-link.
# More-specific OSPF routes retain priority; R5 is the existing Area-1 upstream.
ip link set eth0 up
ip link set eth1 up
ip route replace default via 58.1.1.1 dev eth0

sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons
# Start FRR
/etc/init.d/frr start
