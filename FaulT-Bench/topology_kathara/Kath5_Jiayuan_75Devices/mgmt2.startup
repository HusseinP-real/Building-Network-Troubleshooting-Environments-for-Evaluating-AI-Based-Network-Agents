ip addr replace 192.168.241.12/24 dev eth0
ip link set eth0 up
ip route replace default via 192.168.241.1
# Permit management-side HTTP readers; refuse ordinary business clients.
iptables -C INPUT -p tcp --dport 9100 ! -s 192.168.241.0/24 -j REJECT 2>/dev/null ||
  iptables -A INPUT -p tcp --dport 9100 ! -s 192.168.241.0/24 -j REJECT
if ! pgrep -f '^python3 /opt/soft3888/management.py$' >/dev/null; then
  nohup python3 /opt/soft3888/management.py > /var/log/management.log 2>&1 < /dev/null &
fi
