    "route": "192.168.251.0/24"
  },
  "auxiliary": [
    {
      "name": "branch-g-eth0-failover",
      "injection": {
        "device": "r16",
        "action": "disable one redundant upstream",
        "command": "ip link set eth0 down"
      },
      "checks": [
        {
          "device": "g1",
          "command": "ping -n -W1 -c1 70.1.1.11",
          "expect": "0% loss"
        },
        {
          "device": "r16",
          "command": "ip route get 70.1.1.11 | awk '{print $5}'",
          "expect": "equals: eth1"
        }
      ],
      "recovery": {
        "device": "r16",
        "action": "restore redundant upstream",
        "command": "ip link set eth0 up"
      },
      "recovery_checks": [
        {
          "device": "r16",
          "command": "vtysh -c \"show ip ospf neighbor\" | grep -c Full",
          "expect": "3"
        }
      ]
    },
    {
      "name": "branch-g-eth1-failover",
      "injection": {
        "device": "r16",
        "action": "disable one redundant upstream",
        "command": "ip link set eth1 down"
      },
      "checks": [
        {
          "device": "g1",
          "command": "ping -n -W1 -c1 70.1.1.11",
          "expect": "0% loss"
        },
        {
          "device": "r16",
          "command": "ip route get 70.1.1.11 | awk '{print $5}'",
          "expect": "equals: eth0"
        }
      ],
      "recovery": {
        "device": "r16",
        "action": "restore redundant upstream",
        "command": "ip link set eth1 up"
      },
      "recovery_checks": [
        {
