#!/bin/sh
set -eu
ip link set lo up
ip link set eth0 up
ip address replace 10.255.12.2/30 dev eth0
ip link set eth1 up
ip address replace 10.255.13.2/30 dev eth1
ip link set eth2 up
ip address replace 10.10.2.1/24 dev eth2
ip link set eth3 up
ip address replace 10.40.2.1/24 dev eth3
sed -i 's/^ospfd=no/ospfd=yes/' /etc/frr/daemons
chown frr:frr /etc/frr/frr.conf
chmod 640 /etc/frr/frr.conf
/etc/init.d/frr start
vtysh -c 'show ip ospf' >/dev/null
touch /tmp/p20-ready
