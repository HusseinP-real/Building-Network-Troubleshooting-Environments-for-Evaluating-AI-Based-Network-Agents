#!/bin/sh
set -eu
ip link set lo up
ip link set eth0 up
ip address replace 10.255.31.2/30 dev eth0
ip link set eth1 up
ip address replace 10.255.33.1/30 dev eth1
sed -i 's/^ospfd=no/ospfd=yes/' /etc/frr/daemons
chown frr:frr /etc/frr/frr.conf
chmod 640 /etc/frr/frr.conf
/etc/init.d/frr start
vtysh -c 'show ip ospf' >/dev/null
touch /tmp/p20-ready
