#!/bin/sh
set -eu
ip link set lo up
ip link set eth0 up
ip address replace 10.10.10.1/24 dev eth0
ip link set eth1 up
ip address replace 10.255.12.1/30 dev eth1
ip route replace 10.20.20.0/24 via 10.255.12.2
ip route replace 10.30.30.0/24 via 10.255.12.2
ip route replace 10.40.40.0/24 via 10.255.12.2
ip route replace 10.255.23.0/30 via 10.255.12.2
touch /tmp/p20-ready
