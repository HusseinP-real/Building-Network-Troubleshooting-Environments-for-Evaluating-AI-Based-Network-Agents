#!/bin/sh
set -eu
ip link set lo up
ip link set eth0 up
ip address replace 10.255.23.2/30 dev eth0
ip link set eth1 up
ip address replace 10.20.20.1/24 dev eth1
ip link set eth2 up
ip address replace 10.40.40.1/24 dev eth2
ip route replace 10.10.10.0/24 via 10.255.23.1
ip route replace 10.30.30.0/24 via 10.255.23.1
ip route replace 10.255.12.0/30 via 10.255.23.1
touch /tmp/p20-ready
