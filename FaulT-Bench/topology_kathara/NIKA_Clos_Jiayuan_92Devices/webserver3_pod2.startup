ip addr replace 10.2.4.2/24 dev eth0
ip link set eth0 up
ip route replace default via 10.2.4.1
printf 'nameserver 10.0.0.2\nnameserver 10.1.0.2\noptions timeout:1 attempts:1\n' > /etc/resolv.conf
nohup python3 -m http.server 80 --bind 10.2.4.2 --directory /var/www/html > /var/log/web.log 2>&1 < /dev/null &
