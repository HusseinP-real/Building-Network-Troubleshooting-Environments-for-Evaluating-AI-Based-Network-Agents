ip addr replace 172.16.1.79/31 dev eth0
ip link set eth0 up
ip addr replace 172.16.1.95/31 dev eth1
ip link set eth1 up
ip addr replace 172.16.1.111/31 dev eth2
ip link set eth2 up
ip addr replace 172.16.1.127/31 dev eth3
ip link set eth3 up
ip addr replace 10.3.7.1/24 dev eth4
ip link set eth4 up
sed -i 's/bgpd=no/bgpd=yes/g' /etc/frr/daemons
/etc/init.d/frr start
for attempt in 1 2 3 4 5; do vtysh -b && break; sleep 2; done
