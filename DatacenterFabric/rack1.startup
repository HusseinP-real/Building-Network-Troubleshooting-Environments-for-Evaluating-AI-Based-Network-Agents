#!/bin/bash
set -euo pipefail
exec > /var/log/fabric-startup.log 2>&1
ip link set lo up
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up
ip link set eth4 up
ip link set eth5 up
ip link set eth6 up
ip link set eth7 up
ip link set eth8 up
ip link set eth9 up
ip link set eth10 up
ip link add br0 type bridge stp_state 0
ip link set br0 up
ip link set eth0 master br0
ip link set eth1 master br0
ip link set eth2 master br0
ip link set eth3 master br0
ip link set eth4 master br0
ip link set eth5 master br0
ip link set eth6 master br0
ip link set eth7 master br0
ip link set eth8 master br0
ip link set eth9 master br0
ip link set eth10 master br0
touch /tmp/fabric-ready
