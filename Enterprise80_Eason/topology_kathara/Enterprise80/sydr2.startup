#!/bin/bash
set -e
ip link set eth0 up
ip addr replace 10.255.1.5/30 dev eth0
ip link set eth1 up
ip addr replace 10.255.1.10/30 dev eth1
ip link set eth2 up
ip addr replace 10.10.20.1/24 dev eth2
sed -i 's/^ospfd=no/ospfd=yes/' /etc/frr/daemons
/etc/init.d/frr restart
sleep 2
vtysh -c "configure terminal" \
-c "router ospf" \
-c "ospf router-id 6.6.6.6" \
-c "network 10.255.1.4/30 area 0" \
-c "network 10.255.1.8/30 area 0" \
-c "network 10.10.20.0/24 area 0" \
-c "end"
