#!/bin/bash
set -e
ip link set eth0 up
ip addr replace 10.255.0.10/30 dev eth0
ip link set eth1 up
ip addr replace 10.255.0.13/30 dev eth1
ip link set eth2 up
ip addr replace 10.255.0.22/30 dev eth2
ip link set eth3 up
ip addr replace 10.255.3.6/30 dev eth3
ip link set eth4 up
ip addr replace 10.255.4.2/30 dev eth4
sed -i 's/^ospfd=no/ospfd=yes/' /etc/frr/daemons
/etc/init.d/frr restart
sleep 2
vtysh -c "configure terminal" \
-c "router ospf" \
-c "ospf router-id 4.4.4.4" \
-c "network 10.255.0.8/30 area 0" \
-c "network 10.255.0.12/30 area 0" \
-c "network 10.255.0.20/30 area 0" \
-c "network 10.255.3.4/30 area 0" \
-c "network 10.255.4.0/30 area 0" \
-c "end"
