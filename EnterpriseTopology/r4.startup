#!/bin/bash
set -euo pipefail
exec > /var/log/enterprise-startup.log 2>&1
ip link set lo up
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up
ip link set eth4 up
ip link set eth5 up
ip addr add 10.255.255.4/32 dev lo
ip addr add 10.255.0.10/30 dev eth0
ip addr add 10.255.0.14/30 dev eth1
ip addr add 10.255.0.22/30 dev eth2
ip link add link eth3 name eth3.410 type vlan id 410
ip addr add 10.40.10.3/24 dev eth3.410
ip link set eth3.410 up
ip link add link eth4 name eth4.420 type vlan id 420
ip addr add 10.40.20.3/24 dev eth4.420
ip link set eth4.420 up
ip link add link eth5 name eth5.430 type vlan id 430
ip addr add 10.40.30.3/24 dev eth5.430
ip link set eth5.430 up
sed -i 's/^ospfd=no/ospfd=yes/' /etc/frr/daemons
chown frr:frr /etc/frr/frr.conf
service frr start
keepalived -f /etc/keepalived/keepalived.conf --log-console
iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -A FORWARD -s 10.10.20.2 -d 10.40.20.10 -p udp --sport 67 --dport 67 -j ACCEPT
iptables -A FORWARD -s 10.10.20.3 -d 10.40.20.10 -p udp --sport 67 --dport 67 -j ACCEPT
iptables -A FORWARD -s 10.10.20.0/24 -d 10.40.20.10 -p udp --dport 53 -j ACCEPT
iptables -A FORWARD -s 10.10.20.0/24 -d 10.40.20.10 -p tcp --dport 53 -j ACCEPT
iptables -A FORWARD -s 10.10.20.0/24 -d 10.40.10.10 -p tcp --dport 80 -j ACCEPT
iptables -A FORWARD -s 10.10.20.0/24 -j REJECT
iptables -A FORWARD -d 10.30.20.10 -s 10.30.10.10 -p tcp --dport 8080 -j ACCEPT
iptables -A FORWARD -d 10.30.20.10 -s 10.40.30.0/24 -j ACCEPT
iptables -A FORWARD -d 10.30.20.10 -j REJECT
touch /tmp/enterprise-ready
