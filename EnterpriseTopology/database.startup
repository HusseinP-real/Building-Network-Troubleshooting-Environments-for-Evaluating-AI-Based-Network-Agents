#!/bin/bash
set -euo pipefail
exec > /var/log/enterprise-startup.log 2>&1
ip link set lo up
ip link set eth0 up
ip addr add 10.30.20.10/24 dev eth0
ip route replace default via 10.30.20.1
printf 'nameserver 10.40.20.10\n' > /etc/resolv.conf
python3 -m http.server 8080 --bind 0.0.0.0 --directory /srv/www > /var/log/service.log 2>&1 &
touch /tmp/enterprise-ready
