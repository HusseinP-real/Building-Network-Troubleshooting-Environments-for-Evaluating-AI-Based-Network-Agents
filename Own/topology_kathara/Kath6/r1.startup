ip link set eth0 up
ip link set eth1 up
ip addr flush dev eth0
ip addr flush dev eth1
ip addr add 10.1.0.1/24 dev eth0
ip addr add 10.12.0.1/30 dev eth1
sysctl -w net.ipv4.ip_forward=1

# Healthy-state route. The fault scenario deletes this route at runtime.
ip route replace 10.2.0.0/24 via 10.12.0.2
