#!/bin/sh
set -eu
ip link set lo up
ip addr add 198.51.100.1/24 dev lo
ip link set eth0 up
ip addr replace 172.16.1.1/30 dev eth0
ip link set eth1 up
ip addr replace 172.16.2.1/30 dev eth1
sysctl -w net.ipv4.ip_forward=1 >/dev/null
mkdir -p /etc/frr
cp /hostlab/isp1/frr.conf /etc/frr/frr.conf
cp /hostlab/isp1/daemons /etc/frr/daemons
chown frr:frr /etc/frr/frr.conf || true
chmod 640 /etc/frr/frr.conf
/etc/init.d/frr start
sleep 2
vtysh -b
