#!/bin/sh
set -eu
ip link set lo up
ip link set eth0 up
ip addr replace 10.0.0.18/30 dev eth0
ip link set eth1 up
ip addr replace 10.0.0.21/30 dev eth1
ip link set eth2 up
ip addr replace 10.0.0.34/30 dev eth2
ip link set eth3 up
ip addr replace 10.0.0.62/30 dev eth3
ip link set eth4 up
ip addr replace 10.0.0.94/30 dev eth4
ip link set eth5 up
ip addr replace 10.0.0.106/30 dev eth5
sysctl -w net.ipv4.ip_forward=1 >/dev/null
mkdir -p /etc/frr
cp /hostlab/core5/frr.conf /etc/frr/frr.conf
cp /hostlab/core5/daemons /etc/frr/daemons
chown frr:frr /etc/frr/frr.conf || true
chmod 640 /etc/frr/frr.conf
/etc/init.d/frr start
sleep 2
vtysh -b
