#!/bin/sh
set -eu
ip link set lo up
ip link set eth0 up
ip addr replace 10.0.0.121/30 dev eth0
ip link set eth1 up
ip addr replace 10.0.0.125/30 dev eth1
ip link set eth2 up
ip addr replace 10.20.7.1/24 dev eth2
ip link set eth3 up
ip addr replace 10.20.9.1/24 dev eth3
sysctl -w net.ipv4.ip_forward=1 >/dev/null
mkdir -p /etc/frr
cp /hostlab/dist7/frr.conf /etc/frr/frr.conf
cp /hostlab/dist7/daemons /etc/frr/daemons
chown frr:frr /etc/frr/frr.conf || true
chmod 640 /etc/frr/frr.conf
/etc/init.d/frr start
sleep 2
vtysh -b
