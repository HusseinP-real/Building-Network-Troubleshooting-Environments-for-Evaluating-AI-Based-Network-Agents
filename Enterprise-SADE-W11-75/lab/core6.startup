#!/bin/sh
set -eu
ip link set lo up
ip link set eth0 up
ip addr replace 10.0.0.22/30 dev eth0
ip link set eth1 up
ip addr replace 10.0.0.25/30 dev eth1
ip link set eth2 up
ip addr replace 10.0.0.38/30 dev eth2
ip link set eth3 up
ip addr replace 10.0.0.70/30 dev eth3
ip link set eth4 up
ip addr replace 10.0.0.102/30 dev eth4
ip link set eth5 up
ip addr replace 10.0.0.114/30 dev eth5
sysctl -w net.ipv4.ip_forward=1 >/dev/null
mkdir -p /etc/frr
cp /hostlab/core6/frr.conf /etc/frr/frr.conf
cp /hostlab/core6/daemons /etc/frr/daemons
chown frr:frr /etc/frr/frr.conf || true
chmod 640 /etc/frr/frr.conf
/etc/init.d/frr start
sleep 2
vtysh -b
